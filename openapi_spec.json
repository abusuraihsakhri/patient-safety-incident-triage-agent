{
  "openapi": "3.1.0",
  "info": {
    "title": "Patient Safety Incident Triage Agent API",
    "version": "3.0.1",
    "description": "Illustrative deterministic thresholds only. Not validated for clinical decision support or SAC scoring."
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Unprotected service health check",
        "responses": {
          "200": {
            "description": "Successful request"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory telemetry snapshot",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "503": {
            "description": "API access key not configured"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate synthetic input using demonstration rules",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ],
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  },
                  "attributes": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Invalid or sensitive input"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock response, not model inference",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful request"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Inspect in-memory HMAC audit chain",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  }
}
